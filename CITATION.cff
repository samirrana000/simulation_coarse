    email: samirrana@simulation-coarse.org
    orcid: https://orcid.org/0000-0000-0000-0000
repository-code: https://github.com/samirr/simulation_coarse
url: https://github.com/samirr/simulation_coarse
keywords:
  - coarse-grained
  - elastic network model
  - Generalized Born
  - metadynamics
  - chemical master equation
  - WebGPU
